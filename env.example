# ArmoryHub self-hosted configuration.
#
#   cp .env.selfhost.example .env.selfhost
#   chmod 600 .env.selfhost
#
# Generate every secret below with:  openssl rand -base64 32
# Never commit this file with real values. Never use the placeholders as-is.

# --- Database ---------------------------------------------------------------
# Three separate credentials, on purpose. The app connects as a NON-OWNER role
# so that row-level security actually binds it; if the app were the table owner,
# every RLS policy would silently stop enforcing.
POSTGRES_PASSWORD=CHANGE_ME_superuser
MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator
APP_DB_PASSWORD=CHANGE_ME_app

# --- App --------------------------------------------------------------------
# Host port. Deliberately NOT 3000: a self-hosted box usually runs other things,
# and 3000 is heavily contested (Grafana, most dev servers, much homelab tooling).
# 8477 is arbitrary — change it freely if it clashes with something you run.
#
# Whatever you set here must match your `tailscale serve` command:
#     tailscale serve --bg http://localhost:8477
APP_PORT=8477

# Must match how you actually reach the instance. With the recommended
# Tailscale path (plan §11) this is your https://<host>.<tailnet>.ts.net URL —
# HTTPS is required for PWA install and encryption to work at all.
APP_URL=http://localhost:8477

# Signs the session cookie. Rotating it logs everyone out; it does NOT affect
# encrypted data, which is protected by the PIN/passphrase instead.
AUTH_JWT_SECRET=CHANGE_ME_jwt_secret

# --- Encryption -------------------------------------------------------------
# false = full zero-knowledge: a PIN/passphrase is required each session and the
#         server cannot decrypt anything.
# true  = the instance auto-unlocks after login. Data is still encrypted at rest
#         in Postgres and on disk, but the server CAN decrypt it. This is
#         encryption-at-rest, not zero-knowledge. Opt in knowingly.
ENCRYPTION_AUTO_UNLOCK=false

# --- HTTPS (recommended: Tailscale sidecar) ----------------------------------
# Gives ArmoryHub its own tailnet hostname, e.g. https://armoryhub.<tailnet>.ts.net,
# with a real auto-renewing certificate and no published host port at all.
#
# Generate a REUSABLE auth key: https://login.tailscale.com/admin/settings/keys
# Then start with:  docker compose ... --profile tailscale up -d
#
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=armoryhub

# --- HTTPS (optional: Caddy) -------------------------------------------------
# Only needed if you run the `caddy` profile for a PUBLIC URL on your own domain.
# The recommended path is Tailscale, which needs none of this:
#     tailscale serve --bg http://localhost:3000
#
# CADDY_SITE_ADDRESS=armory.example.com
# CADDY_ACME_EMAIL=you@example.com
# Non-standard ports must appear in CADDY_SITE_ADDRESS too, e.g. host:8443
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER=fs
STORAGE_PATH=/data/files

# --- Realtime ---------------------------------------------------------------
# Self-hosted polls updated_at rather than running a websocket service.
REALTIME_MODE=poll
REALTIME_POLL_MS=30000

# --- Licence ----------------------------------------------------------------
# Ed25519-signed, verified entirely offline. The instance never contacts
# armoryhub.app — no license server, no phone-home, no telemetry.
LICENSE_FILE=/data/license.jwt

# --- Legal documents (optional) ---------------------------------------------
# Defaults point at the self-hosted agreement on armoryhub.app. Override if you
# want the in-app links to go somewhere else.
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms

# --- Branding (optional) ----------------------------------------------------
# BRAND_NAME=ArmoryHub
# BRAND_SHORT_NAME=ArmoryHub
# BRAND_THEME_COLOR=#09090B
# BRANDING_PATH=/data/branding

# --- Not used in self-hosted mode -------------------------------------------
# No Supabase, Stripe, Resend, Vercel Analytics or Google Ads keys are needed
# or read. A self-hosted instance sends zero email and makes zero outbound
# requests. The NEXT_PUBLIC_SUPABASE_* placeholders in the Dockerfile exist only
# because the current code reads them at module scope; Phase 1 removes that.
