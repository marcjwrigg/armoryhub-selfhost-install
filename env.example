# ArmoryHub self-hosted configuration.
#
#   cp env.example .env
#   chmod 600 .env
#
# If you used install.sh you already have a completed version of this file and
# nothing here needs editing. This template is for setting one up by hand.
#
# Generate every secret below with:  openssl rand -base64 32
# Keep this file. Losing POSTGRES_PASSWORD locks the app out of its own database.

# --- Database ---------------------------------------------------------------
# Set all three to different generated values.
#
# They are separate because the app connects as a non-owner role, which is what
# keeps row-level security enforced. If you consolidate them and the app ends up
# owning its tables, its access rules stop applying and every record becomes
# readable by that connection.
POSTGRES_PASSWORD=CHANGE_ME_superuser
MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator
APP_DB_PASSWORD=CHANGE_ME_app

# --- App --------------------------------------------------------------------
# Port on this machine. Change it if 8477 clashes with something you already run.
APP_PORT=8477

# Which address the app listens on. Leave this alone unless you run your own reverse
# proxy.
#
# 127.0.0.1 means the app is reachable only from this machine, so nobody on your wifi
# can reach an unencrypted login page. Reach your instance over HTTPS instead.
#
# Set APP_BIND=0.0.0.0 only if your own reverse proxy cannot reach loopback — that is,
# it runs in a Docker bridge network or on a different machine. It serves plain HTTP
# to your whole LAN, so only do it with the proxy terminating TLS in front. A proxy
# running in host network mode on this machine does NOT need this.
#
# Cleanest alternative: attach your proxy to this stack's network and point it at
# app:3000, so nothing is published on the host at all.
# APP_BIND=0.0.0.0

# The address you actually use to reach the instance. Set this to your HTTPS
# address once you have one, for example:
#
#   APP_URL=https://armoryhub.your-tailnet.ts.net
#
# Leaving it as localhost works only from the server itself. HTTPS is required to
# unlock your data or install the app to a phone home screen.
APP_URL=http://localhost:8477

# Signs your login session. Generate with:  openssl rand -base64 48
#
# Safe to change: it signs you out and nothing more. It does not touch your
# encrypted records, which are protected by your PIN and passphrase instead.
AUTH_JWT_SECRET=CHANGE_ME_jwt_secret

# --- Which optional services start ------------------------------------------
# Keeps the Tailscale sidecar in every `docker compose up -d`. Leave this set.
#
# Without it, Tailscale only starts when you remember to add
# `--profile tailscale`. Once it has been stopped for any reason — a reboot, or a
# `compose down` that included the profile — a plain `up -d` leaves it down and your
# HTTPS address silently stops resolving. That looks exactly like the app being
# broken: a blank page and nothing in the browser console.
#
# Set it to `caddy` instead if you use a public domain.
COMPOSE_PROFILES=tailscale

# --- HTTPS (recommended: Tailscale) -----------------------------------------
# Gives your instance its own address, e.g. https://armoryhub.your-tailnet.ts.net,
# with a real certificate that renews itself. Nothing is exposed to the internet
# and you change no router or firewall settings.
#
#   docker compose --profile tailscale up -d
#
# It then prints a link. Open it, sign in, approve the machine, and you are done.
#
# TS_AUTHKEY is only needed for an unattended install, where nobody is present to
# click that link. If you need one, it must be reusable and non-ephemeral:
# https://login.tailscale.com/admin/settings/keys
#
# TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=armoryhub

# Once the machine is approved, set APP_URL above to the https://...ts.net address.
# If you installed through CasaOS, Portainer or similar, also update the app's
# Web UI address there — those dashboards cannot detect it for you.

# --- HTTPS (alternative: Caddy) ---------------------------------------------
# Only if you want a PUBLIC address on a domain you own, instead of Tailscale.
# This one does need a DNS record and ports 80 and 443 reachable from the
# internet, which is why it is not the default.
#
#   docker compose --profile caddy up -d
#
# CADDY_SITE_ADDRESS=armory.example.com
# CADDY_ACME_EMAIL=you@example.com
#
# If you use non-standard ports, include the port in CADDY_SITE_ADDRESS too,
# e.g. armory.example.com:8443
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- Storage ----------------------------------------------------------------
# Your photos and documents live in ./data/app/files, and the database in
# ./data/postgres. There is nothing to set here — the paths are fixed — but WHERE you
# put ./data matters.
#
# Keep it on ordinary local storage. Do not put it on a FUSE mount or a network share:
# on Unraid use a cache-backed path rather than a /mnt/user/... share, because user
# shares go through shfs (FUSE) and Postgres on FUSE risks locking errors and
# corruption. The same applies to NFS and SMB.

# --- Updates in the browser -------------------------------------------------
# How often an open tab checks for changes, in milliseconds. Raise it to reduce
# database queries; lower it if you use two devices at once and want them to
# catch up faster.
REALTIME_POLL_MS=30000

# --- Backups ----------------------------------------------------------------
# A backup runs every day at BACKUP_HOUR (24-hour clock, UTC) and is written as
# ordinary files you can copy with whatever you already use.
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Pre-migration and pre-restore dumps — the safety copies taken automatically
# before anything changes the database. Not part of the daily/weekly policy above,
# because they are not scheduled: one exists for every upgrade and every restore.
BACKUP_KEEP_SAFETY=3

# --- Where backups go -------------------------------------------------------
# By default: ./data/backups. That is the same disk as the database it is
# protecting, so one disk failure loses the records AND every backup of them.
#
# Do not edit these by hand. Use the helper, which creates the directory, gives it
# to the right user, writes the marker file described below, and copies your
# existing backups across:
#
#   armoryhub backup path   /mnt/disk2/armoryhub-backups
#   armoryhub backup mirror /mnt/nas/armoryhub-backups
#
# BACKUP_PATH is the primary destination. BACKUP_MIRROR_PATH is an optional second
# copy, written after the primary has been taken AND verified.
#
# Set both if you can. Relocating the only copy trades "one disk failure loses
# everything" for "the share was unmounted at 03:00, so there is no backup at all
# tonight". Two destinations degrade instead of failing. The contents are already
# encrypted, so somebody else's NAS or a cloud mount is a fine destination.
# BACKUP_PATH=/mnt/disk2/armoryhub-backups
# BACKUP_MIRROR_PATH=/mnt/nas/armoryhub-backups
# BACKUP_MIRROR_ENABLED=false

# Refuse to write backups if the marker file .armoryhub-backups is missing.
#
# Worth understanding, because it guards the failure that has no symptoms. A bind
# mount whose source has gone does NOT error: Docker creates an empty directory at
# that path on the root disk and mounts that instead. Backups then keep succeeding
# onto the very disk you moved them off, every check passes, and you find out when
# you need them.
#
# The marker lives on the destination's own filesystem, so it disappears exactly
# when the destination does. `armoryhub backup path` turns this on for you when it
# moves the primary somewhere that can vanish on its own; it stays off for the
# default ./data/backups, which cannot.
# BACKUP_REQUIRE_MARKER=false

# --- Managing the server from a browser (optional) --------------------------
# `armoryhub portal on` adds a Settings -> Server page with the health checks,
# backups, updates, logs and a configuration editor.
#
# Do not set these by hand. That command writes a separate docker-compose.portal.yml
# and points COMPOSE_FILE at it, because what it turns on is the Docker socket being
# mounted into the app container — and the Docker socket is root on the host.
# Anything able to drive it can create a container with / mounted and run any
# command as root, and the app is also the part that faces your network.
#
# So it is off by default, and off means the socket mount is not in your compose
# file at all rather than merely present and unused. Everything the page does also
# works from the `armoryhub` command line.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.portal.yml

# --- Legal documents (optional) ---------------------------------------------
# In-app links point at armoryhub.app by default. Point them elsewhere if you
# prefer.
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms

# --- Things you do not need -------------------------------------------------
# No Supabase, Stripe, email or analytics keys are required or read. A
# self-hosted instance sends no email and reports nothing back to us.
