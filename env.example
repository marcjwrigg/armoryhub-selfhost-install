# ArmoryHub self-hosted configuration.
#
#   cp env.example .env
#   chmod 600 .env
#
# If you used install.sh you already have a completed version of this file and
# nothing here needs editing. This template is for setting one up by hand.
#
# Generate every secret below with:  openssl rand -base64 32
# Keep this file. Losing POSTGRES_PASSWORD locks the app out of its own database.

# --- Database ---------------------------------------------------------------
# Set all three to different generated values.
#
# They are separate because the app connects as a non-owner role, which is what
# keeps row-level security enforced. If you consolidate them and the app ends up
# owning its tables, its access rules stop applying and every record becomes
# readable by that connection.
POSTGRES_PASSWORD=CHANGE_ME_superuser
MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator
APP_DB_PASSWORD=CHANGE_ME_app

# --- App --------------------------------------------------------------------
# Port on this machine. Change it if 8477 clashes with something you already run.
#
# The app listens on 127.0.0.1 only, so this port is not reachable from other
# machines on your network — reach your instance over HTTPS instead (see below).
APP_PORT=8477

# The address you actually use to reach the instance. Set this to your HTTPS
# address once you have one, for example:
#
#   APP_URL=https://armoryhub.your-tailnet.ts.net
#
# Leaving it as localhost works only from the server itself. HTTPS is required to
# unlock your data or install the app to a phone home screen.
APP_URL=http://localhost:8477

# Signs your login session. Generate with:  openssl rand -base64 48
#
# Safe to change: it signs you out and nothing more. It does not touch your
# encrypted records, which are protected by your PIN and passphrase instead.
AUTH_JWT_SECRET=CHANGE_ME_jwt_secret

# --- Encryption -------------------------------------------------------------
# false  Your PIN is required once per session, and the server cannot read your
#        records at all. This is the default and the recommended setting.
#
# true   The instance unlocks itself after you log in. Your records stay
#        encrypted on disk, but this server can decrypt them without you —
#        so anyone who gets access to the running machine can read them.
#        Convenient, and a genuine reduction in protection. Choose it knowingly.
ENCRYPTION_AUTO_UNLOCK=false

# --- HTTPS (recommended: Tailscale) -----------------------------------------
# Gives your instance its own address, e.g. https://armoryhub.your-tailnet.ts.net,
# with a real certificate that renews itself. Nothing is exposed to the internet
# and you change no router or firewall settings.
#
#   docker compose --profile tailscale up -d
#
# It then prints a link. Open it, sign in, approve the machine, and you are done.
#
# TS_AUTHKEY is only needed for an unattended install, where nobody is present to
# click that link. If you need one, it must be reusable and non-ephemeral:
# https://login.tailscale.com/admin/settings/keys
#
# TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=armoryhub

# Once the machine is approved, set APP_URL above to the https://...ts.net address.
# If you installed through CasaOS, Portainer or similar, also update the app's
# Web UI address there — those dashboards cannot detect it for you.

# --- HTTPS (alternative: Caddy) ---------------------------------------------
# Only if you want a PUBLIC address on a domain you own, instead of Tailscale.
# This one does need a DNS record and ports 80 and 443 reachable from the
# internet, which is why it is not the default.
#
#   docker compose --profile caddy up -d
#
# CADDY_SITE_ADDRESS=armory.example.com
# CADDY_ACME_EMAIL=you@example.com
#
# If you use non-standard ports, include the port in CADDY_SITE_ADDRESS too,
# e.g. armory.example.com:8443
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- Storage ----------------------------------------------------------------
# Your photos and documents, stored as files under ./data/app/files.
STORAGE_DRIVER=fs
STORAGE_PATH=/data/files

# --- Updates in the browser -------------------------------------------------
# How often an open tab checks for changes, in milliseconds. Raise it to reduce
# database queries; lower it if you use two devices at once and want them to
# catch up faster.
REALTIME_MODE=poll
REALTIME_POLL_MS=30000

# --- Backups ----------------------------------------------------------------
# A backup runs every day at BACKUP_HOUR (24-hour clock, server time) and is
# written to ./data/backups, where you can copy it like any other file.
#
# Copy them off this machine. Backups on the same disk do not survive that disk
# failing. Their contents are already encrypted, so cloud storage is fine.
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Licence ----------------------------------------------------------------
# Where the instance reads its licence file from.
LICENSE_FILE=/data/license.jwt

# --- Legal documents (optional) ---------------------------------------------
# In-app links point at armoryhub.app by default. Point them elsewhere if you
# prefer.
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms

# --- Branding (optional) ----------------------------------------------------
# BRAND_NAME=ArmoryHub
# BRAND_SHORT_NAME=ArmoryHub
# BRAND_THEME_COLOR=#09090B
# BRANDING_PATH=/data/branding

# --- Things you do not need -------------------------------------------------
# No Supabase, Stripe, email or analytics keys are required or read. A
# self-hosted instance sends no email and reports nothing back to us.
